# Test-network wallets only. Never put a key that holds real money here.
BASE_SEPOLIA_RPC=https://sepolia.base.org
ADMIN_KEY=0x...        # admin (also acts as screener unless SCREENER_KEY is set)
OPERATOR_A_KEY=0x...   # operator Alpha
OPERATOR_B_KEY=0x...   # operator Bravo
SCREENER_KEY=          # optional separate screener wallet

# Optional deploy parameters
MIN_PHASE=30           # minimum seconds for commit and reveal windows
ATTEST_WINDOW=3600     # seconds after closest approach that screeners may attest
QUORUM=1               # matching screener attestations needed
